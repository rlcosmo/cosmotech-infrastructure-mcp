# Optional AWS profile and region. boto3 otherwise uses its normal credential chain.
AWS_PROFILE=
AWS_REGION=us-east-1

# HTTP refuses to start without a token and binds to loopback by default.
# Generate a high-entropy value locally; never commit the real .env file.
MCP_HTTP_BEARER_TOKEN=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_ALLOW_NON_LOOPBACK=false

# Process and output limits.
COSMOTECH_COMMAND_TIMEOUT_SECONDS=15
COSMOTECH_MAX_OUTPUT_BYTES=65536
COSMOTECH_AUDIT_LOG=
# By default commands can access only this project directory. Add another root
# (for example the parent repository) explicitly when inspecting its Terraform.
COSMOTECH_ALLOWED_ROOTS=
FASTMCP_CHECK_FOR_UPDATES=off
